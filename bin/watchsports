def sanitize_query(query_parts):
    query = " ".join(query_parts)
    cleaned = re.sub(r"['\":?!,]", "", query)
    cleaned = re.sub(r"\s+", " ", cleaned).strip()
    return cleaned

def get_match_status(date_str, time_str):
    if not date_str:
        return ""
    try:
        t_str = time_str if time_str and time_str != "00:00:00" else "19:00:00"
        match_dt_utc = datetime.datetime.strptime(f"{date_str} {t_str}", "%Y-%m-%d %H:%M:%S").replace(tzinfo=datetime.timezone.utc)
        now_utc = datetime.datetime.now(datetime.timezone.utc)
        diff_seconds = (now_utc - match_dt_utc).total_seconds()
        
        local_tz = datetime.datetime.now().astimezone().tzinfo
        local_dt = match_dt_utc.astimezone(local_tz)
        local_time_str = local_dt.strftime("%I:%M %p %Z").lstrip("0")
        
        if 0 <= diff_seconds <= 7500:
            minutes = int(diff_seconds // 60)
            return f"\033[1;31m🔴 LIVE NOW ({minutes}')\033[0m — Kicked off at {local_time_str}"
        elif 7500 < diff_seconds <= 10800:
            return f"\033[1;33m🟡 FULL TIME / POST-MATCH\033[0m — Started at {local_time_str}"
        elif diff_seconds < 0:
            hours_until = int(abs(diff_seconds) // 3600)
            mins_until = int((abs(diff_seconds) % 3600) // 60)
            if hours_until == 0:
                return f"\033[1;36m⏰ UPCOMING (Starts in {mins_until} mins)\033[0m — {local_time_str}"
            elif hours_until < 24 and match_dt_utc.date() == now_utc.date():
                return f"\033[1;36m⏰ TODAY at {local_time_str}\033[0m (Starts in {hours_until}h {mins_until}m)"
            else:
                return f"\033[1;36m⏰ UPCOMING\033[0m — {local_dt.strftime('%A, %b %d at %I:%M %p %Z')}"
        else:
            return f"\033[0;37mFinished ({date_str})\033[0m"
    except Exception:
        return f"Scheduled: {date_str} {time_str}"

def lookup_fixture(query):
    try:
        url = "https://www.thesportsdb.com/api/v1/json/3/searchteams.php?t=" + urllib.parse.quote(query)
        req = urllib.request.Request(
            url,
            headers={
                "User-Agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36"
            }
        )
        with urllib.request.urlopen(req, timeout=3.5) as r:
            d = json.loads(r.read())
            teams = d.get("teams") or []
            if not teams:
                return None
            team = teams[0]
            team_id = team.get("idTeam")
            team_name = team.get("strTeam")
            league = team.get("strLeague")

            ev_url = "https://www.thesportsdb.com/api/v1/json/3/eventsnext.php?id=" + str(team_id)
            req2 = urllib.request.Request(
                ev_url,
                headers={
                    "User-Agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36"
                }
            )
            with urllib.request.urlopen(req2, timeout=3.5) as r2:
                d2 = json.loads(r2.read())
                events = d2.get("events") or []
                if events:
                    ev = events[0]
                    return {
                        "team": team_name,
                        "league": league,
                        "match": ev.get("strEvent"),
                        "date": ev.get("dateEvent"),
                        "time": ev.get("strTime"),
                        "venue": ev.get("strVenue", "Stadium"),
                    }
    except Exception:
        pass
    return None

def verify_single_channel(ch):
    url = ch.get("url", "")
    if not url:
        return None
    try:
        req = urllib.request.Request(
            url,
            headers={
                "User-Agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
            }
        )
        with urllib.request.urlopen(req, timeout=2.2) as resp:
            if resp.status in (200, 206, 301, 302, 307, 308):
                return ch
    except Exception:
        pass
    return None

def fetch_sports_channels(force_refresh=False):
    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    
    if not force_refresh and CACHE_FILE.exists():
        try:
            mtime = CACHE_FILE.stat().st_mtime
            if time.time() - mtime < CACHE_EXPIRY:
                with open(CACHE_FILE, "r", encoding="utf-8") as f:
                    data = json.load(f)
                    if data:
                        return data
        except Exception:
            pass

    print("\033[1;34m⚡ Probing and verifying live sports channels...\033[0m")
    raw_channels = list(CURATED_CHANNELS)
    seen_urls = set(c["url"] for c in raw_channels)

    # Check for user-provided custom IPTV playlist
    user_playlist = Path.home() / ".config" / "watchsports" / "playlist.m3u"
    if user_playlist.exists():
        try:
            with open(user_playlist, "r", encoding="utf-8", errors="ignore") as pf:
                lines = pf.read().splitlines()
                current_name = None
                current_group = "My Playlist"
                for line in lines:
                    line = line.strip()
                    if line.startswith("#EXTINF"):
                        if "," in line:
                            current_name = line.rsplit(",", 1)[-1].strip()
                        else:
                            current_name = "Custom Channel"
                        match_group = re.search(r'group-title="([^"]+)"', line)
                        current_group = match_group.group(1) if match_group else "My Playlist"
                    elif line.startswith("http") and current_name:
                        stream_url = line
                        if stream_url not in seen_urls:
                            seen_urls.add(stream_url)
                            raw_channels.append({
                                "name": current_name,
                                "category": current_group,
                                "url": stream_url
                            })
                        current_name = None
        except Exception:
            pass

    url = "https://iptv-org.github.io/iptv/categories/sports.m3u"
    try:
        req = urllib.request.Request(
            url,
            headers={
                "User-Agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
            },
        )
        with urllib.request.urlopen(req, timeout=6) as resp:
            content = resp.read().decode("utf-8", errors="ignore")
            lines = content.splitlines()
            current_name = None
            current_group = "Sports"
            
            for line in lines:
                line = line.strip()
                if line.startswith("#EXTINF"):
                    if "," in line:
                        current_name = line.rsplit(",", 1)[-1].strip()
                    else:
                        current_name = "Unknown Sport"
                    match_group = re.search(r'group-title="([^"]+)"', line)
                    current_group = match_group.group(1) if match_group else "Sports"
                elif line.startswith("http") and current_name:
                    stream_url = line
                    if stream_url not in seen_urls:
                        seen_urls.add(stream_url)
                        raw_channels.append({
                            "name": current_name,
                            "category": current_group,
                            "url": stream_url
                        })
                    current_name = None
    except Exception:
        pass

    verified_channels = []
    with concurrent.futures.ThreadPoolExecutor(max_workers=35) as executor:
        futures = [executor.submit(verify_single_channel, ch) for ch in raw_channels]
        for f in concurrent.futures.as_completed(futures):
            res = f.result()
            if res:
                verified_channels.append(res)

    try:
        with open(CACHE_FILE, "w", encoding="utf-8") as f:
            json.dump(verified_channels, f)
    except Exception:
        pass

    return verified_channels

def check_url_live(url):
    try:
        req = urllib.request.Request(
            url,
            headers={"User-Agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"}
        )
        with urllib.request.urlopen(req, timeout=3.0) as r:
            return r.status in (200, 206, 301, 302, 307, 308)
    except Exception:
        return False

def play_stream(url, title="Live Sports"):
    print(f"\n\033[1;32m▶ Launching Stream:\033[0m \033[1;37m{title}\033[0m")
    
    # Pre-flight check for direct HLS stream URLs
    if any(ext in url.lower() for ext in [".m3u8", ".ts", ".mpd"]):
        print("\033[1;34m[Connecting] Verifying stream connection...\033[0m")
        if not check_url_live(url):
            print(f"\033[1;31m❌ Error: Stream server is currently unreachable.\033[0m")
            print("Please select another channel from the list.\n")
            return False

    has_streamlink = shutil.which("streamlink") is not None

    mpv_live_args = (
        f"--title=\"watchsports: {title}\" "
        "--cache=yes "
        "--demuxer-max-bytes=150M "
        "--demuxer-readahead-secs=20 "
        "--cache-pause=yes "
        "--cache-pause-wait=2 "
        "--demuxer-lavf-o=reconnect=1,reconnect_streamed=1,reconnect_delay_max=5 "
        "--demuxer-lavf-buffersize=1048576 "
        "--correct-pts=yes "
        "--hr-seek=no "
        "--msg-level=ffmpeg=error,demuxer=error "
        "--hwdec=auto-safe "
        "--tls-verify=no"
    )

    # Use Streamlink if available to de-jitter HLS, handle discontinuities, and buffer multi-threaded
    if has_streamlink:
        print("\033[1;34m[Stream Engine] Initializing multi-threaded stream buffer (Streamlink + MPV)...\033[0m\n")
        cmd = [
            "streamlink",
            "--stream-segment-threads", "3",
            "--stream-segment-timeout", "6",
            "--stream-segment-attempts", "3",
            "--ringbuffer-size", "32M",
            "--hls-live-restart",
            "--retry-open", "3",
            "--retry-streams", "3",
            "--player", "mpv",
            "--player-args", mpv_live_args,
            url,
            "best"
        ]
        try:
            res = subprocess.run(cmd)
            if res.returncode == 0:
                return True
        except KeyboardInterrupt:
            return True

    # Fallback to direct MPV playback with resilient live buffering options
    print("\033[1;34m[Direct MPV] Launching with resilient buffer & auto-reconnect...\033[0m\n")
    mpv_cmd = [
        "mpv",
        f"--title=watchsports: {title}",
        "--cache=yes",
        "--demuxer-max-bytes=150M",
        "--demuxer-readahead-secs=20",
        "--cache-pause=yes",
        "--cache-pause-wait=2",
        "--demuxer-lavf-o=reconnect=1,reconnect_streamed=1,reconnect_delay_max=5",
        "--demuxer-lavf-buffersize=1048576",
        "--correct-pts=yes",
        "--hr-seek=no",
        "--msg-level=ffmpeg=error,demuxer=error",
        "--hwdec=auto-safe",
        "--tls-verify=no",
        "--ytdl-raw-options=no-check-certificates=",
        url
    ]
    try:
        res = subprocess.run(mpv_cmd)
        if res.returncode != 0:
            print("\n\033[1;33m⚠ Stream ended or disconnected.\033[0m")
        return True
    except KeyboardInterrupt:
        return True

def main():
    if len(sys.argv) > 1 and sys.argv[1] in ["-h", "--help", "help"]:
        print(HELP_TEXT)
        sys.exit(0)

    if len(sys.argv) > 1 and sys.argv[1] in ["--refresh", "--update"]:
        channels = fetch_sports_channels(force_refresh=True)
        print(f"\033[1;32m✓ Verified and cached {len(channels)} live sports channels.\033[0m")
        sys.exit(0)

    if len(sys.argv) > 2 and sys.argv[1] in ["-s", "--stream"]:
        target_url = sys.argv[2]
        play_stream(target_url, title="Custom Stream")
        sys.exit(0)

    query_parts = sys.argv[1:]
    clean_query = sanitize_query(query_parts) if query_parts else ""

    term_width = shutil.get_terminal_size((100, 24)).columns

    fixture = None
    GENERIC_SPORTS = {
        "f1", "formula 1", "racing", "motorsport", "nascar", "motogp",
        "nba", "basketball", "tennis", "golf", "pga", "ufc", "mma", "boxing",
        "cricket", "baseball", "mlb", "nfl", "ucl", "champions league"
    }

    if clean_query:
        print(f"\033[1;34m🔍 Checking live match status & channels for: \"{clean_query}\"...\033[0m\n")
        if clean_query.lower() not in GENERIC_SPORTS:
            fixture = lookup_fixture(clean_query)
        if fixture:
            status_badge = get_match_status(fixture.get("date"), fixture.get("time"))
            match_title = fixture.get("match")
            league_name = fixture.get("league")
            
            box_width = min(term_width - 4, 90)
            print(" \033[1;36m┌" + "─" * box_width + "┐\033[0m")
            print(f" \033[1;36m│\033[0m  \033[1;32m⚽ MATCH:\033[0m \033[1;37m{match_title:<{box_width-11}}\033[0m\033[1;36m│\033[0m")
            print(f" \033[1;36m│\033[0m  \033[1;33m🏆 LEAGUE:\033[0m {league_name:<{box_width-12}}\033[1;36m│\033[0m")
            print(f" \033[1;36m│\033[0m  \033[1;35m📡 STATUS:\033[0m {status_badge:<{box_width+3}}\033[1;36m│\033[0m")
            
            b_info = "ESPN+ / ESPN Deportes, DAZN LaLiga, Movistar+, Premier Sports" if "la liga" in (league_name or "").lower() else "Sky Sports, TNT Sports, Peacock, NBC, CBS Golazo"
            print(f" \033[1;36m│\033[0m  \033[1;34m📺 NETWORKS:\033[0m \033[0;37m{b_info:<{box_width-14}}\033[0m\033[1;36m│\033[0m")
            print(" \033[1;36m└" + "─" * box_width + "┘\033[0m\n")

    channels = fetch_sports_channels()

    if clean_query:
        q_lower = clean_query.lower()
        stopwords = {"united", "city", "real", "fc", "club", "de", "and", "the", "la", "sports", "sport", "tv", "hd", "live", "network", "vs", "league"}
        words = [w for w in re.split(r"\s+", q_lower) if len(w) > 2 and w not in stopwords]

        detected_sport = None
        detected_league = (fixture.get("league") if fixture else "").lower()
        associated_terms = []

        if "la liga" in detected_league or "spanish" in detected_league:
            detected_sport = "football"
            associated_terms.extend(["espn", "deportes", "dazn", "bein", "arena", "spain", "laliga", "movistar"])
        elif "premier league" in detected_league or "english" in detected_league:
            detected_sport = "football"
            associated_terms.extend(["cbs", "golazo", "arena", "aspor", "sky", "premier", "storm", "football"])
        elif "champions" in detected_league or "uefa" in detected_league:
            detected_sport = "football"
            associated_terms.extend(["golazo", "cbs", "arena", "aspor", "football", "uefa"])
        elif "serie a" in detected_league or "italian" in detected_league:
            detected_sport = "football"
            associated_terms.extend(["cbs", "golazo", "arena", "football", "italy"])
        elif "bundesliga" in detected_league or "german" in detected_league:
            detected_sport = "football"
            associated_terms.extend(["espn", "arena", "football", "german"])

        for k, (sport, league, terms) in SPORT_LEAGUE_MAP.items():
            if k in q_lower:
                if not detected_sport:
                    detected_sport = sport
                associated_terms.extend(terms)

        associated_terms = list(dict.fromkeys(associated_terms))

        def term_matches(term, text):
            if len(term) <= 4:
                return bool(re.search(r"\b" + re.escape(term) + r"\b", text, re.IGNORECASE))
            return term in text.lower()

        def match_channel(item):
            name_low = item["name"].lower()
            cat_low = item.get("category", "").lower()
            tags = item.get("tags", [])
            score = 0

            if q_lower in name_low:
                score += 50

            for w in words:
                if term_matches(w, name_low):
                    score += 30
                elif any(term_matches(w, t) for t in tags):
                    score += 25

            for term in associated_terms:
                if any(term_matches(term, t) for t in tags):
                    score += 20
                elif term_matches(term, name_low):
                    score += 12
                elif term_matches(term, cat_low):
                    score += 6

            if detected_sport:
                if detected_sport == "football":
                    if any(x in name_low for x in ["darts", "golf", "combat", "horse", "pga", "tennis", "cricket", "fishing", "racing"]):
                        score -= 40
                elif detected_sport == "motorsport":
                    if any(x in name_low for x in ["darts", "golf", "football", "soccer", "tennis", "cricket", "fifa", "basketball"]):
                        score -= 40
                elif detected_sport == "tennis":
                    if any(x in name_low for x in ["football", "soccer", "racing", "golf", "fifa", "basketball"]):
                        score -= 40
                elif detected_sport == "basketball":
                    if any(x in name_low for x in ["golf", "racing", "fifa", "tennis", "combat"]):
                        score -= 40

            return score

        results = [c for c in channels if match_channel(c) > 0]
        results.sort(key=match_channel, reverse=True)
    else:
        print("\033[1;34m📺 Browsing Verified Live Sports Channels...\033[0m\n")
        results = channels

    if not results:
        print(f"\033[1;33mℹ️  No matching live sports channels found for \"{clean_query}\".\033[0m")
        print("Tip: Run 'watchsports' without arguments to browse all online channels, or paste a URL with 'watchsports -s <url>'.")
        sys.exit(0)

    max_display = min(len(results), 25)

    while True:
        print(f" {'#':<3}  {'TYPE / LEAGUE':<28}   {'VERIFIED ONLINE LIVE FEED'}")
        print(" " + "─" * (min(term_width - 2, 96)))

        for idx in range(max_display):
            item = results[idx]
            cat = item.get("category", "Live Sports")[:26]
            name = item.get("name", "Unknown")
            print(f" \033[1;37m{idx:<3}\033[0m  \033[1;36m{cat:<28}\033[0m   \033[1;32m{name}\033[0m")

        print(" " + "─" * (min(term_width - 2, 96)))

        try:
            choice = input(f"\n\033[1;36mSelect a channel (0-{max_display-1}), paste a URL, or 'q' to quit:\033[0m ").strip()
        except (KeyboardInterrupt, EOFError):
            print("\nExiting.")
            sys.exit(0)

        if choice.lower() in ["q", "quit", "exit"]:
            sys.exit(0)

        if choice.startswith("http://") or choice.startswith("https://"):
            play_stream(choice, title="Custom Match Stream")
            continue

        if choice.isdigit() and 0 <= int(choice) < max_display:
            selected = results[int(choice)]
            play_stream(selected["url"], title=selected["name"])
            print("\n" + "─" * 40 + "\n")
        else:
            print(f"\033[1;31mInvalid choice. Please enter a number (0-{max_display-1}) or paste a URL.\033[0m")

if __name__ == "__main__":
    main()
