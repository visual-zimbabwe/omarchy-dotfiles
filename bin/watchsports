CACHE_EXPIRY = 43200  # 12 hours

HELP_TEXT = """\033[1;36m
  ⚽ watchsports - CLI Live Sports & Channel Streamer
\033[0m
Usage:
  \033[1;32mwatchsports <team or league>\033[0m          Search for live fixtures, status & verified broadcast channels
  \033[1;32mwatchsports\033[0m                           Browse all available verified live sports networks
  \033[1;32mwatchsports -s <stream-or-url>\033[0m        Stream any live URL/M3U8 directly in mpv/Streamlink
  \033[1;32mwatchsports --refresh\033[0m                 Force re-verify and refresh sports channel cache
  \033[1;32mwatchsports --help\033[0m                    Show this help message

Examples:
  watchsports barcelona
  watchsports "manchester united"
  watchsports "premier league"
  watchsports arsenal
  watchsports laliga
  watchsports "real madrid"
  watchsports ucl
  watchsports f1
  watchsports -s "https://example.com/live/feed.m3u8"

Tips:
  • Automatically verifies stream health before listing to ensure 100% working channels.
  • Shows live match status, clock, and official broadcast networks.
  • Streams open in \033[1;36mmpv\033[0m with low-latency buffering enabled.
  • Press \033[1;36mq\033[0m to close the stream, or \033[1;36mf\033[0m to toggle fullscreen in mpv.
"""

