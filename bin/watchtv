def sanitize_query(query_parts):
    query = " ".join(query_parts).strip()
    if not query:
        return ""
    # Remove apostrophes cleanly ("Grey's" -> "Greys", "It's" -> "Its")
    query = re.sub(r"['’`]", "", query)
    # Normalize "Season X Episode Y" / "s1 e2" -> "S01E02"
    query = re.sub(
        r"\b(?:season|s)\s*(\d{1,2})\s*(?:episode|ep|e|x)\s*(\d{1,3})\b",
        lambda m: f"S{int(m.group(1)):02d}E{int(m.group(2)):02d}",
        query,
        flags=re.IGNORECASE,
    )
    # Normalize "1x05" -> "S01E05"
    query = re.sub(
        r"\b(\d{1,2})x(\d{1,3})\b",
        lambda m: f"S{int(m.group(1)):02d}E{int(m.group(2)):02d}",
        query,
        flags=re.IGNORECASE,
    )
    # Normalize compact "s1e2" -> "S01E02"
    query = re.sub(
        r"\b[sS](\d{1,2})[eE](\d{1,3})\b",
        lambda m: f"S{int(m.group(1)):02d}E{int(m.group(2)):02d}",
        query,
    )
    cleaned = re.sub(r"[^\w\s\-.]", " ", query)
    cleaned = re.sub(r"[\-_]+", " ", cleaned)
    cleaned = re.sub(r"\s+", " ", cleaned).strip()
    return cleaned

def generate_search_variants(query):
    variants = [query]
    if re.search(r"\bS\d{2}E\d{2}\b", query, re.IGNORECASE):
        variants.append(query.replace(" ", "."))
    return list(dict.fromkeys(v for v in variants if v))

def format_size(bytes_val):
    try:
        b = float(bytes_val)
        if b >= 1024 * 1024 * 1024:
            return f"{b / (1024**3):.2f} GiB"
        elif b >= 1024 * 1024:
            return f"{b / (1024**2):.1f} MiB"
        return f"{b / 1024:.0f} KiB"
    except Exception:
        return "N/A"

def is_season_pack(name: str) -> bool:
    """Detect if release is a multi-episode Season pack."""
    norm = name.lower()
    if re.search(r"\b(complete|season\s*\d+\b|s\d{1,2}(?!\s*e\d{1,2})\b|s\d{1,2}-s\d{1,2}|batch|all\s*episodes|pack)\b", norm):
        # Make sure it's not a single episode release like S01E03
        if not re.search(r"\bs\d{1,2}e\d{1,2}\b", norm):
            return True
        elif "complete" in norm or "season" in norm or "pack" in norm:
            return True
    return False

def highlight_name(name, show_pack_tag=True):
    # Highlight useful tags for easy reading
    formatted = name
    if show_pack_tag and re.search(r"(?i)(?:^|[\s.\-_\[])(rar|zip|7z|tar\.gz|iso)(?:$|[\s.\-_\]])", name):
        formatted = f"\033[1;41;97m[ARCHIVE]\033[0m {formatted}"
    if show_pack_tag and is_season_pack(name):
        formatted = f"\033[1;45;97m[SEASON PACK]\033[0m {formatted}"

    formatted = re.sub(r"(?i)\b(multi|multisubs?)\b", "\033[1;33m\\1\033[0m", formatted)
    formatted = re.sub(r"(?i)\b(esub|esubs|sub|subs)\b", "\033[1;32m\\1\033[0m", formatted)
    formatted = re.sub(r"(?i)\b(1080p|720p|2160p|4k)\b", "\033[1;36m\\1\033[0m", formatted)
    formatted = re.sub(r"(?i)\b(x265|hevc|10bit)\b", "\033[1;35m\\1\033[0m", formatted)
    formatted = re.sub(r"(?i)\b(s\d{1,2}e\d{1,2})\b", "\033[1;32m\\1\033[0m", formatted)
    return formatted

STOP_WORDS = {
    "the", "a", "an", "of", "in", "and", "or", "to", "for", "on", "with",
    "at", "by", "from", "del", "la", "le", "il", "lo", "un", "una", "de",
    "di", "el", "los", "las", "der", "die", "das"
}

def normalize_text(text):
    text = text.lower()
    text = re.sub(r"[._\-+\[\](){}'\":?!,/]", " ", text)
    text = re.sub(r"\s+", " ", text).strip()
    return text

def calculate_match_score(release_name, query, target_episode=None):
    norm_release = normalize_text(release_name)
    norm_query = normalize_text(query)

    release_words = norm_release.split()
    query_words = norm_query.split()

    if not query_words:
        return 0.0

    # Separate season/episode token and optional 4-digit year from core title keywords
    se_match = re.search(r"\bs(\d{1,2})e(\d{1,3})\b", norm_query)
    year_match = re.search(r"\b(19\d\d|20\d\d)\b", norm_query)
    se_token = se_match.group(0) if se_match else None
    year_token = year_match.group(1) if year_match else None

    core_words = [
        w for w in query_words
        if w not in STOP_WORDS and w != se_token and w != year_token
    ]
    if not core_words:
        core_words = [w for w in query_words if w not in STOP_WORDS] or query_words

    matched_count = 0
    for q_word in core_words:
        stem = q_word[:-1] if q_word.endswith("s") and len(q_word) > 3 else q_word
        if any(stem == rw or rw.startswith(stem) or stem in rw for rw in release_words):
            matched_count += 1

    # Require >= 75% title keyword match (100% for 1-3 word queries, allows 1 missing word on 4+ word queries)
    if (matched_count / len(core_words)) < 0.75:
        return 0.0

    score = 10.0

    # Season/Episode check: allow exact episode OR matching season pack (S01 / Season 1)
    if se_match:
        s_num = int(se_match.group(1))
        e_num = int(se_match.group(2))
        ep_re = rf"(?:s0?{s_num}\.?e0?{e_num}\b|0?{s_num}x0?{e_num}\b)"
        season_pack_re = rf"(?:s0?{s_num}\b|season\s*0?{s_num}\b)"
        if re.search(ep_re, release_name, re.IGNORECASE):
            score += 150.0
        elif re.search(season_pack_re, release_name, re.IGNORECASE) and is_season_pack(release_name):
            score += 60.0
        else:
            return 0.0

    query_phrase = " ".join(query_words)
    core_phrase = " ".join(core_words)

    if query_phrase in norm_release:
        score += 100.0
    elif core_phrase in norm_release:
        score += 80.0
    else:
        stemmed_core = " ".join([w[:-1] if w.endswith("s") and len(w) > 3 else w for w in core_words])
        if stemmed_core in norm_release:
            score += 70.0

    if year_token and year_token in norm_release:
        score += 40.0

    # Season pack bonus when searching for seasons
    if is_season_pack(release_name):
        score += 30.0

    # Target episode bonus
    if target_episode:
        try:
            ep_int = int(target_episode)
            ep_patterns = [
                f"e{ep_int:02d}",
                f"e{ep_int}",
                f"episode {ep_int}",
            ]
            if any(ep in norm_release for ep in ep_patterns):
                score += 150.0
        except ValueError:
            pass

    return score

def fetch_apibay(query, target_episode=None):
    try:
        url = f"https://apibay.org/q.php?q={urllib.parse.quote(query)}"
        req = urllib.request.Request(
            url,
            headers={
                "User-Agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
            },
        )
        with urllib.request.urlopen(req, timeout=5) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            if isinstance(data, list) and data and data[0].get("name") != "No results returned":
                results = []
                for item in data:
                    name = item.get("name", "Unknown")
                    info_hash = item.get("info_hash", "").lower()
                    if not info_hash:
                        continue
                    score = calculate_match_score(name, query, target_episode)
                    if score > 0:
                        results.append({
                            "name": name,
                            "info_hash": info_hash,
                            "seeders": int(item.get("seeders", 0) or 0),
                            "leechers": int(item.get("leechers", 0) or 0),
                            "size": int(item.get("size", 0) or 0),
                            "score": score,
                            "source": "TPB",
                        })
                return results
    except Exception:
        pass
    return []

def fetch_solidtorrents(query, target_episode=None):
    try:
        url = f"https://solidtorrents.to/api/v1/search?q={urllib.parse.quote(query)}&sort=seeders"
        req = urllib.request.Request(
