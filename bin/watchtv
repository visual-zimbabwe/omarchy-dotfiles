            headers={
                "User-Agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
            },
        )
        with urllib.request.urlopen(req, timeout=5) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            results_raw = data.get("results", [])
            results = []
            for item in results_raw:
                name = item.get("title", "Unknown")
                info_hash = (item.get("infohash") or "").lower()
                if not info_hash:
                    continue
                score = calculate_match_score(name, query, target_episode)
                if score > 0:
                    results.append({
                        "name": name,
                        "info_hash": info_hash,
                        "seeders": int(item.get("seeders", 0) or 0),
                        "leechers": int(item.get("leechers", 0) or 0),
                        "size": int(item.get("size", 0) or 0),
                        "score": score,
                        "source": "Solid",
                    })
            return results
    except Exception:
        pass
    return []

def _extract_show_title(query):
    cleaned = re.sub(r"(?i)\b(s\d{1,2}(?:e\d{1,3})?|season\s*\d+|episode\s*\d+|\d{1,2}x\d{1,3}|complete|pack|batch)\b", " ", query)
    cleaned = re.sub(r"(?i)\b(2160p|1080p|720p|480p|4k|x264|x265|hevc|web-?dl|webrip|bluray|hdtv)\b", " ", cleaned)
    cleaned = re.sub(r"\b(19\d{2}|20\d{2})\b", " ", cleaned)
    return re.sub(r"\s+", " ", cleaned).strip()

def fetch_eztv(query, target_episode=None):
    """Resolve show IMDb ID via TVMaze and query EZTV by imdb_id."""
    show_title = _extract_show_title(query)
    if not show_title or len(show_title) < 2:
        return []
    headers = {
        "User-Agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
    }
    try:
        tv_url = f"https://api.tvmaze.com/singlesearch/shows?q={urllib.parse.quote(show_title)}"
        with urllib.request.urlopen(urllib.request.Request(tv_url, headers=headers), timeout=3) as tv_resp:
            tv_data = json.loads(tv_resp.read().decode("utf-8"))
        imdb_raw = (tv_data.get("externals") or {}).get("imdb") or ""
        imdb_digits = re.sub(r"\D", "", str(imdb_raw))
        if not imdb_digits:
            return []

        url = f"https://eztvx.to/api/get-torrents?imdb_id={imdb_digits}&limit=100"
        with urllib.request.urlopen(urllib.request.Request(url, headers=headers), timeout=5) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            torrents = data.get("torrents") or []
            results = []
            for item in torrents:
                name = item.get("filename") or item.get("title") or "Unknown"
                info_hash = (item.get("hash") or "").strip().lower()
                if not info_hash:
                    continue
                score = calculate_match_score(name, query, target_episode)
                if score > 0:
                    results.append({
                        "name": name,
                        "info_hash": info_hash,
                        "seeders": int(item.get("seeds", 0) or 0),
                        "leechers": int(item.get("peers", 0) or 0),
                        "size": int(item.get("size_bytes", 0) or 0),
                        "score": score,
                        "source": "EZTV",
                    })
            return results
    except Exception:
        pass
    return []

